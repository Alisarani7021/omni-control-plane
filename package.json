{
  "name": "v13-control-plane",
  "version": "13.1.0",
  "private": true,
  "type": "module",
  "description": "Secure multi-tenant BYOC control plane for Cloudflare, Telegram and sing-box VPS nodes",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir .wrangler-build",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:sing-box": "bash scripts/verify-sing-box.sh",
    "preflight": "node scripts/preflight.mjs",
    "check": "npm run preflight && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "oxlint": "1.82.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "ws": "8.21.3"
  }
}
